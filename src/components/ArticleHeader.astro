---
interface Props {
  backHref: string;
  backLabel: string;
  kicker?: string;
  date?: Date;
  title: string;
  dek?: string;
}

const { backHref, backLabel, kicker, date, title, dek } = Astro.props;
const dateStr = date?.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const [main, ...rest] = title.split(': ');
const sub = rest.join(': ');
const tags = (kicker ?? '').split('/').map(s => s.trim()).filter(Boolean);
const tagColors = ['bg-sky', 'bg-butter', 'bg-mint', 'bg-lilac'];
---

<header class="pt-10 md:pt-14 mb-12">
  <a href={backHref} class="px-btn !text-[0.72rem] !py-1.5 mb-10">◀ {backLabel}</a>

  <div class="flex flex-wrap items-center gap-2 mb-5 anim-pop">
    {tags.map((t, i) => <span class={`px-chip ${tagColors[i % tagColors.length]}`}>{t}</span>)}
    {dateStr && <span class="label ml-1">{dateStr}</span>}
  </div>

  <h1 class="!m-0 font-pixel font-bold tracking-tight leading-[0.98] text-5xl md:text-7xl anim-pop delay-1">
    {main}
  </h1>
  {sub && <p class="mt-3 mb-0 font-pixel text-2xl md:text-3xl text-ink-2 anim-pop delay-2">{sub}</p>}

  {dek && (
    <p class="mt-8 mb-0 max-w-2xl text-xl text-ink-2 leading-relaxed border-l-[6px] border-butter pl-5 anim-pop delay-3">
      {dek}
    </p>
  )}
</header>
