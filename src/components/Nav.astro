---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { label: 'Projects', href: '/projects', key: '1', color: 'bg-sky' },
  { label: 'Research', href: '/research', key: '2', color: 'bg-lilac' },
  { label: 'Writing',  href: '/writing',  key: '3', color: 'bg-mint' },
  { label: 'Funsies',  href: '/funsies',  key: '4', color: 'bg-butter' },
  { label: 'Arcade',   href: '/arcade',   key: '5', color: 'bg-tomato' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---

<nav class="sticky top-0 z-50 bg-bg/90 backdrop-blur-sm border-b-[3px] border-ink">
  <div class="flex justify-between items-center max-w-6xl mx-auto px-4 md:px-8 h-[68px]">

    <!-- Wordmark -->
    <a href="/" class="group flex items-center gap-3" aria-label="Yimin Huang, home">
      <img src="/images/pixel/me-48.png" alt="" width="36" height="36" class="pixelated w-9 h-9 border-[3px] border-ink bg-bg-2 group-hover:-rotate-6 transition-transform" />
      <span class="font-pixel text-xl md:text-2xl font-semibold leading-none">yimin<span class="text-tomato">.</span>huang</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-2">
      {navItems.map(item => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class={`group flex items-center gap-2 px-3 py-1.5 border-[3px] font-label text-[0.78rem] transition-[transform,box-shadow] duration-100 ${
            isActive(item.href)
              ? `${item.color} !text-[#2a2140] border-ink shadow-[3px_3px_0_var(--shadow)]`
              : 'border-transparent text-ink-2 hover:border-ink hover:bg-bg-2 hover:shadow-[3px_3px_0_var(--shadow)] hover:-translate-y-0.5'
          }`}
        >
          <kbd class="text-[0.6rem] px-1 border-2 border-current leading-none py-0.5 opacity-70">{item.key}</kbd>
          {item.label}
        </a>
      ))}
      <span class="w-1"></span>
      <button type="button" data-hud-open aria-label="Open quest log (Q)" title="Quest log · Q" class="flex items-center gap-2 h-10 px-2.5 border-[3px] border-ink bg-card shadow-[3px_3px_0_var(--shadow)] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-transform font-label text-[0.68rem]">
        <span class="px-1 bg-lilac text-[#2a2140] border-2 border-ink leading-none py-0.5">LV <span data-hud-level>1</span></span>
        <span class="w-12 h-2.5 border-2 border-ink bg-bg-2 relative overflow-hidden"><span data-hud-bar class="absolute inset-y-0 left-0 bg-mint" style="width:0%"></span></span>
        <span class="text-ink">◎ <span data-hud-coins>0</span></span>
      </button>
      <ThemeToggle />
    </div>

    <!-- Mobile controls -->
    <div class="lg:hidden flex items-center gap-2">
      <button type="button" data-hud-open aria-label="Open quest log" class="h-10 px-2 border-[3px] border-ink bg-lilac text-[#2a2140] shadow-[3px_3px_0_var(--shadow)] font-label text-[0.68rem]">LV <span data-hud-level>1</span> · ◎ <span data-hud-coins>0</span></button>
      <ThemeToggle id="theme-toggle-mobile" />
      <button
        id="mobile-menu-btn"
        class="w-10 h-10 grid place-items-center border-[3px] border-ink bg-card shadow-[3px_3px_0_var(--shadow)]"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" width="18" height="18" viewBox="0 0 6 6" shape-rendering="crispEdges" fill="currentColor"><rect y="0" width="6" height="1"/><rect y="2.5" width="6" height="1"/><rect y="5" width="6" height="1"/></svg>
        <svg id="icon-close" width="18" height="18" viewBox="0 0 6 6" shape-rendering="crispEdges" fill="currentColor" class="hidden"><rect x="0" y="0" width="1" height="1"/><rect x="1" y="1" width="1" height="1"/><rect x="2" y="2" width="2" height="2"/><rect x="4" y="4" width="1" height="1"/><rect x="5" y="5" width="1" height="1"/><rect x="5" y="0" width="1" height="1"/><rect x="4" y="1" width="1" height="1"/><rect x="1" y="4" width="1" height="1"/><rect x="0" y="5" width="1" height="1"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="lg:hidden hidden border-t-[3px] border-ink bg-bg">
    <div class="flex flex-col gap-3 p-4">
      {navItems.map(item => (
        <a
          href={item.href}
          class={`flex items-center justify-between px-4 py-3 border-[3px] border-ink shadow-[3px_3px_0_var(--shadow)] font-pixel text-xl ${
            isActive(item.href) ? `${item.color} !text-[#2a2140]` : 'bg-card'
          }`}
        >
          {item.label}
          <span class="font-label text-xs">▶</span>
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const btn  = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    document.getElementById('icon-open')?.classList.toggle('hidden', open);
    document.getElementById('icon-close')?.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
