---
import { getCollection } from 'astro:content';
import { SECRETS, LOOSE_PAGES } from '../lib/secrets';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const research = (await getCollection('research')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const writing  = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const data = {
  secrets: SECRETS.map(({ id, name }) => ({ id, name })),
  pages: LOOSE_PAGES,
  ls: {
    projects: projects.map(p => p.id),
    research: research.map(r => r.id),
    writing:  writing.map(w => w.id),
  },
};
---

<script type="application/json" id="secret-data" set:html={JSON.stringify(data)} />

<!-- Achievement toasts -->
<div id="toasts" class="fixed bottom-4 right-4 z-[200] flex flex-col gap-3 items-end pointer-events-none" aria-live="polite"></div>

<!-- Scene modal -->
<div id="scene" class="fixed inset-0 z-[150] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="scene-kicker">
  <div data-scene-backdrop class="absolute inset-0 bg-[#17132b]/80 [background-image:radial-gradient(rgba(255,255,255,.08)_1px,transparent_1px)] [background-size:6px_6px]"></div>
  <div data-scene-box class="relative w-full max-w-xl px-box anim-pop">
    <div class="flex items-center justify-between border-b-[3px] border-ink px-4 py-2 bg-butter text-[#2a2140]">
      <span id="scene-kicker" class="font-label text-[0.75rem]"></span>
      <button type="button" data-scene-close class="font-label text-[0.75rem] hover:text-tomato" aria-label="Close">[esc] ✕</button>
    </div>
    <div data-scene-body class="p-6 md:p-8"></div>
  </div>
</div>

<style is:global>
  .toast-in { animation: toastIn 0.4s steps(4) both; }
  .toast-out { animation: toastIn 0.3s steps(3) reverse both; }
  @keyframes toastIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  .shake { animation: shake 0.35s steps(4); }
  @keyframes shake { 0%,100% { transform: translateX(0) rotate(-1.5deg); } 25% { transform: translateX(-6px) rotate(-3deg); } 75% { transform: translateX(6px) rotate(1deg); } }

  .confetti-bit { position: fixed; width: 8px; height: 8px; z-index: 300; pointer-events: none; border: 2px solid #2a2140; }

  /* ↑↑↓↓←→←→BA handheld mode */
  html.handheld main, html.handheld nav, html.handheld footer {
    filter: grayscale(1) sepia(1) hue-rotate(48deg) saturate(1.7) brightness(0.92) contrast(1.05);
  }
  html.handheld body { background-color: #c4cfa1; }

  .px-box.cube-scene { background: #000; color: #f5ecd9; border-color: #000; box-shadow: 0 0 60px rgba(232, 93, 63, 0.35); }
  .px-box.cube-scene > div:first-child { background: #000; color: #8f86ab; border-color: #2a2140; }
</style>

<script>
  type Page = { line: string; from: string; href: string };
  const DATA = JSON.parse(document.getElementById('secret-data')?.textContent || '{}') as {
    secrets: { id: string; name: string }[];
    pages: Page[];
    ls: { projects: string[]; research: string[]; writing: string[] };
  };
  const TOTAL = DATA.secrets.length;
  const KEY = 'yimin.secrets';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  // ── Storage ──────────────────────────────────────────
  function found(): string[] {
    const ids = new Set(DATA.secrets.map(s => s.id));
    try { return (JSON.parse(localStorage.getItem(KEY) || '[]') as string[]).filter(id => ids.has(id)); } catch { return []; }
  }
  function save(list: string[]) {
    try { localStorage.setItem(KEY, JSON.stringify(list)); } catch {}
  }

  function updateCounters() {
    const n = found().length;
    document.querySelectorAll('[data-secret-count]').forEach(el => { el.textContent = `${n}/${TOTAL}`; });
    document.dispatchEvent(new CustomEvent('secrets:changed'));
  }

  // ── 8-bit chime ──────────────────────────────────────
  let audio: AudioContext | undefined;
  function chime(notes = [523, 659, 784, 1047]) {
    try {
      audio ??= new AudioContext();
      const t0 = audio.currentTime;
      notes.forEach((f, i) => {
        const o = audio!.createOscillator();
        const g = audio!.createGain();
        o.type = 'square';
        o.frequency.value = f;
        g.gain.setValueAtTime(0.035, t0 + i * 0.08);
        g.gain.exponentialRampToValueAtTime(0.0001, t0 + i * 0.08 + 0.12);
        o.connect(g).connect(audio!.destination);
        o.start(t0 + i * 0.08);
        o.stop(t0 + i * 0.08 + 0.13);
      });
    } catch {}
  }

  // ── Confetti (a nod to Bubblist) ─────────────────────
  const COLORS = ['#e85d3f', '#f5c04a', '#5aa9e6', '#78c99b', '#b49cf0'];
  function confetti(x: number, y: number, count = 26) {
    if (reduce) return;
    const bits = Array.from({ length: count }, () => {
      const el = document.createElement('span');
      el.className = 'confetti-bit';
      el.style.background = COLORS[Math.floor(Math.random() * COLORS.length)];
      document.body.appendChild(el);
      return { el, x, y, vx: (Math.random() - 0.5) * 9, vy: -Math.random() * 9 - 3, life: 0 };
    });
    const tick = () => {
      let alive = false;
      bits.forEach(b => {
        b.life++;
        b.vy += 0.38;
        b.x += b.vx;
        b.y += b.vy;
        b.el.style.transform = `translate(${Math.round(b.x / 4) * 4}px, ${Math.round(b.y / 4) * 4}px)`;
        b.el.style.left = '0'; b.el.style.top = '0';
        if (b.life < 70) alive = true; else b.el.remove();
      });
      if (alive) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // ── Toast ────────────────────────────────────────────
  function toast(title: string, sub: string, link: { href: string; label: string } = { href: '/secrets', label: 'sticker book' }) {
    const wrap = document.getElementById('toasts');
    if (!wrap) return;
    const el = document.createElement('div');
    el.className = 'px-box toast-in pointer-events-auto flex items-center gap-3 px-4 py-3 max-w-[320px]';
    el.innerHTML = `
      <span class="grid place-items-center w-9 h-9 bg-butter border-[3px] border-ink text-[#2a2140] font-label text-sm shrink-0">★</span>
      <span class="min-w-0">
        <span class="block font-label text-[0.65rem] text-tomato">${esc(title)}</span>
        <span class="block font-pixel text-lg leading-tight">${esc(sub)}</span>
        <a href="${link.href}" class="block font-label text-[0.6rem] text-muted hover:text-tomato mt-1">${esc(link.label)} ▶</a>
      </span>`;
    wrap.appendChild(el);
    setTimeout(() => { el.classList.replace('toast-in', 'toast-out'); setTimeout(() => el.remove(), 320); }, 4200);
  }

  function unlock(id: string) {
    const list = found();
    if (list.includes(id)) return;
    list.push(id);
    save(list);
    const s = DATA.secrets.find(x => x.id === id);
    chime();
    toast(`Secret found · ${list.length}/${TOTAL}`, s?.name ?? id);
    document.dispatchEvent(new CustomEvent('secret:unlocked', { detail: id }));
    if (list.length === TOTAL) {
      setTimeout(() => { chime([523, 659, 784, 1047, 1319, 1568]); toast('All secrets found!', 'You know me pretty well now ♥'); confetti(innerWidth / 2, innerHeight / 3, 60); }, 1200);
    }
    updateCounters();
  }

  // ── Scene modal ──────────────────────────────────────
  const scene = document.getElementById('scene')!;
  const sceneBox = scene.querySelector<HTMLElement>('[data-scene-box]')!;
  const sceneBody = scene.querySelector<HTMLElement>('[data-scene-body]')!;
  const sceneKicker = document.getElementById('scene-kicker')!;
  let lastFocus: Element | null = null;
  let typeTimers: number[] = [];

  function openScene(kicker: string, html: string, opts: { dark?: boolean } = {}) {
    lastFocus = document.activeElement;
    sceneKicker.textContent = kicker;
    sceneBody.innerHTML = html;
    sceneBox.classList.toggle('cube-scene', !!opts.dark);
    scene.classList.remove('hidden');
    scene.classList.add('flex');
    scene.querySelector<HTMLElement>('[data-scene-close]')?.focus();
  }
  function closeScene() {
    typeTimers.forEach(clearTimeout);
    typeTimers = [];
    scene.classList.add('hidden');
    scene.classList.remove('flex');
    (lastFocus as HTMLElement | null)?.focus?.();
  }
  scene.querySelector('[data-scene-close]')?.addEventListener('click', closeScene);
  scene.querySelector('[data-scene-backdrop]')?.addEventListener('click', closeScene);
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !scene.classList.contains('hidden')) closeScene(); });

  /** Reveal [data-type] children one after another, typing their text. */
  function typeIn(root: HTMLElement, speed = 24) {
    const els = Array.from(root.querySelectorAll<HTMLElement>('[data-type]'));
    const texts = els.map(el => el.textContent ?? '');
    els.forEach(el => { el.textContent = ''; });
    if (reduce) { els.forEach((el, i) => { el.textContent = texts[i]; }); return; }
    let delay = 150;
    els.forEach((el, i) => {
      const t = texts[i];
      for (let n = 1; n <= t.length; n++) {
        typeTimers.push(window.setTimeout(() => { el.textContent = t.slice(0, n); }, delay + n * speed));
      }
      delay += t.length * speed + 350;
    });
  }

  // ── Eggs ─────────────────────────────────────────────

  // 1. Poke the portrait
  const pokeLines = ['hi!', 'hehe, that tickles', 'that’s my face', 'ok ok, you found me', 'secret: my play opens April 2027 ♥'];
  let pokes = 0;
  document.querySelectorAll<HTMLElement>('[data-egg="poke"]').forEach(el => {
    el.addEventListener('click', () => {
      const bubble = el.querySelector<HTMLElement>('[data-poke-bubble]');
      el.classList.remove('shake'); void el.offsetWidth; el.classList.add('shake');
      if (bubble) {
        bubble.textContent = pokeLines[Math.min(pokes, pokeLines.length - 1)];
        bubble.classList.remove('hidden');
      }
      pokes++;
      chime([392 + pokes * 40]);
      if (pokes >= 5) unlock('poke');
    });
  });

  // 2. Pop the Bubblist bubble
  document.querySelectorAll<HTMLElement>('[data-egg="bubble"]').forEach(el => {
    el.addEventListener('click', () => {
      const r = el.getBoundingClientRect();
      confetti(r.left + r.width / 2, r.top + r.height / 2);
      chime([880, 1175]);
      el.style.visibility = 'hidden';
      const tag = document.createElement('span');
      tag.className = 'fixed z-[120] font-label text-[0.7rem] px-2 py-0.5 bg-mint text-[#2a2140] border-2 border-ink toast-in';
      tag.style.left = `${r.left - 10}px`; tag.style.top = `${r.top}px`;
      tag.textContent = '✓ task done';
      document.body.appendChild(tag);
      setTimeout(() => tag.remove(), 1600);
      setTimeout(() => { el.style.visibility = ''; }, 5000);
      unlock('bubble');
    });
  });

  // 3. Bake the loaf
  const bakeSteps = ['proofing…', 'rising…', 'almost…', 'fully baked! ♥'];
  document.querySelectorAll<HTMLElement>('[data-egg="bread"]').forEach(el => {
    let step = 0;
    const label = el.querySelector<HTMLElement>('[data-bake-label]');
    const sprite = el.querySelector<HTMLElement>('[data-bake-sprite]');
    el.addEventListener('click', () => {
      step = Math.min(step + 1, bakeSteps.length);
      if (sprite) sprite.style.transform = `scale(${1 + step * 0.18})`;
      if (label) { label.textContent = bakeSteps[step - 1]; label.classList.remove('hidden'); }
      chime([330 + step * 90]);
      if (step === bakeSteps.length) {
        const r = el.getBoundingClientRect();
        confetti(r.left + r.width / 2, r.top, 18);
        unlock('bread');
        setTimeout(() => { step = 0; if (sprite) sprite.style.transform = ''; label?.classList.add('hidden'); }, 3000);
      }
    });
  });

  // 4. Talk to the NPC
  document.querySelectorAll<HTMLElement>('[data-egg="npc"]').forEach(el => {
    const speech = document.querySelector<HTMLElement>('[data-npc-speech]');
    const walker = document.querySelector<HTMLElement>('[data-npc-walker]');
    el.addEventListener('click', () => {
      const open = speech?.classList.toggle('hidden') === false;
      walker?.classList.toggle('paused', open);
      if (open) { chime([262, 330]); unlock('npc'); }
    });
  });

  // 5. Type "joy" anywhere
  function joyScene() {
    openScene('SCENE · A café, on its last day', `
      <p data-type class="m-0 text-lg text-ink-2">A bewildered stranger walks in.</p>
      <p data-type class="mt-2 mb-0 text-lg text-ink-2">He is looking for someone named Joy.</p>
      <p data-type class="mt-6 mb-0 font-pixel text-3xl md:text-4xl leading-tight">“What’s the point of singing songs, if they’ll never even hear you?”</p>
      <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
        <span class="font-label text-[0.7rem] text-muted">from <em>If They’ll Never Hear You</em> · Vertigo mainstage, April 2027</span>
        <a href="/writing/if-theyll-never-hear-you" class="px-btn">Read about the play ▶</a>
      </div>`);
    typeIn(sceneBody);
    unlock('joy');
  }

  // 6. The black cube
  document.querySelectorAll<HTMLElement>('[data-egg="cube"]').forEach(el => {
    el.addEventListener('click', () => {
      openScene('▓▓▓ ▓▓▓▓▓▓▓', `
        <div class="py-6 text-center">
          <p data-type class="m-0 font-pixel text-4xl md:text-5xl tracking-wide text-[#f5ecd9]">THE PAST IS NEVER DEAD.</p>
          <p data-type class="mt-4 mb-0 font-pixel text-2xl md:text-3xl text-[#e85d3f]">IT’S NOT EVEN PAST.</p>
          <p class="mt-8 mb-0 font-label text-[0.65rem] text-[#8f86ab]">— William Faulkner · this line used to hide under my photo</p>
        </div>`, { dark: true });
      typeIn(sceneBody, 45);
      chime([196, 185, 175]);
      unlock('cube');
    });
  });

  // 7. Skill tree (handled on the homepage; it dispatches this event)
  document.addEventListener('egg:skills', () => unlock('skills'));

  // 8. Loose pages
  document.querySelectorAll<HTMLElement>('[data-egg="pages"]').forEach(el => {
    el.addEventListener('click', () => {
      el.classList.remove('shake'); void el.offsetWidth; el.classList.add('shake');
      const p = DATA.pages[Math.floor(Math.random() * DATA.pages.length)];
      setTimeout(() => {
        openScene('A loose page fell out…', `
          <div class="bg-card border-[3px] border-ink p-6 rotate-[-1deg] shadow-[4px_4px_0_var(--shadow)] [background-image:repeating-linear-gradient(transparent_0_31px,rgba(90,169,230,.35)_31px_33px)]">
            <p data-type class="m-0 text-2xl leading-[33px] text-ink">${esc(p.line)}</p>
          </div>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <span class="font-label text-[0.7rem] text-muted">from <em>${esc(p.from)}</em></span>
            <span class="flex gap-3">
              <button type="button" data-another class="px-btn">Shake again</button>
              <a href="${p.href}" class="px-btn !bg-tomato !text-[#fffaf0]">Read ▶</a>
            </span>
          </div>`);
        typeIn(sceneBody, 28);
        sceneBody.querySelector('[data-another]')?.addEventListener('click', () => { closeScene(); el.click(); });
      }, 300);
      unlock('pages');
    });
  });

  // 9. Boot the computer
  document.querySelectorAll<HTMLElement>('[data-egg="terminal"]').forEach(el => {
    el.addEventListener('click', () => {
      const line = (s: string, cls = '') => `<p data-type class="m-0 ${cls}">${esc(s)}</p>`;
      openScene('yimin@northwestern: ~', `
        <div class="bg-[#17132b] text-[#7fdba6] border-[3px] border-ink p-5 font-label text-[0.78rem] leading-relaxed min-h-[260px]">
          ${line('> whoami', 'text-[#ffd166]')}
          ${line('yimin huang · product · cs + cogsci + design · northwestern')}
          ${line('> ls ~/projects', 'text-[#ffd166] mt-3')}
          ${line(DATA.ls.projects.join('  '))}
          ${line('> ls ~/research', 'text-[#ffd166] mt-3')}
          ${line(DATA.ls.research.join('  '))}
          ${line('> cat now.txt', 'text-[#ffd166] mt-3')}
          ${line('writing a stage play. opening april 2027.')}
          ${line('> _', 'text-[#ffd166] mt-3')}
        </div>`);
      typeIn(sceneBody, 7);
      unlock('terminal');
    });
  });

  // 10. Spin the globe
  document.querySelectorAll<HTMLElement>('[data-egg="globe"]').forEach(el => {
    el.addEventListener('click', () => {
      el.classList.remove('shake'); void el.offsetWidth; el.classList.add('shake');
      chime([523, 587, 659, 784, 880]);
      const place = (name: string, zh: string, note: string, color: string) => `
        <li class="flex items-center gap-3 p-3 border-[3px] border-ink ${color} text-[#2a2140] shadow-[3px_3px_0_var(--shadow)]">
          <span class="font-label text-lg leading-none">⌖</span>
          <span class="flex-1"><span class="font-pixel text-xl">${name}</span> <span class="text-base">${zh}</span></span>
          <span class="font-label text-[0.62rem]">${note}</span>
        </li>`;
      setTimeout(() => {
        openScene('Around the world · 环游世界', `
          <p data-type class="m-0 font-pixel text-5xl leading-none">你好！</p>
          <p data-type class="mt-2 mb-5 text-lg text-ink-2">Hello! Welcome. 欢迎来到我的小世界。</p>
          <ul class="list-none p-0 m-0 grid gap-3">
            ${place('China', '中国', 'grew up', 'bg-tomato')}
            ${place('Singapore', '新加坡', 'went to school', 'bg-butter')}
            ${place('Evanston, IL', '埃文斯顿', 'Northwestern, now', 'bg-sky')}
          </ul>
          <div class="mt-5 grid grid-cols-3 gap-3 text-center">
            <div class="border-[3px] border-ink p-2"><span class="block font-label text-[0.6rem] text-muted">Language</span><span class="font-pixel text-xl">English</span></div>
            <div class="border-[3px] border-ink p-2"><span class="block font-label text-[0.6rem] text-muted">语言</span><span class="text-xl font-semibold">中文</span></div>
            <div class="border-[3px] border-ink p-2"><span class="block font-label text-[0.6rem] text-muted">язык · learning</span><span class="text-xl font-semibold">Русский</span></div>
          </div>
          <p class="mt-5 mb-0 text-ink-2">Moving between cultures is what my research is about: how people explore other cultures, and reflect on their own, with AI.</p>
          <div class="mt-5 flex justify-end">
            <a href="/research/experiential-computing" class="px-btn">Read the research ▶</a>
          </div>`);
        typeIn(sceneBody, 40);
        unlock('globe');
      }, 350);
    });
  });

  // 11. Тетрадь flashcards
  const A = '\u0301';
  const CARDS = [
    { ru: `тетра${A}дь`, en: 'exercise book', g: 'f.' },
    { ru: `приве${A}т`, en: 'hi', g: '' },
    { ru: `спаси${A}бо`, en: 'thank you', g: '' },
    { ru: `кни${A}га`, en: 'book', g: 'f.' },
  ];
  const stressHtml = (ru: string) => esc(ru).replace(new RegExp(`([аеёиоуыэюя])${A}`, 'gi'), '<span class="text-[#d0293a] font-semibold">$1</span>');
  function tetradScene(start = 0) {
    let i = start, flipped = false;
    const render = () => {
      const c = CARDS[i];
      const card = sceneBody.querySelector<HTMLElement>('[data-fc]');
      if (!card) return;
      card.innerHTML = `
        <p lang="ru" class="m-0 text-5xl font-medium text-[#1a1c1e]">${stressHtml(c.ru)}</p>
        ${c.g ? `<p class="m-0 mt-1 text-[#bb2848] font-semibold">${c.g}</p>` : ''}
        <p class="m-0 mt-4 text-2xl ${flipped ? 'text-[#177a4f]' : 'text-transparent select-none'}">${esc(c.en)}</p>`;
      const btn = sceneBody.querySelector<HTMLElement>('[data-fc-flip]');
      if (btn) btn.textContent = flipped ? 'Next card ▶' : 'Flip ↻';
    };
    openScene('Тетрадь · flashcards', `
      <div data-fc class="relative min-h-[220px] flex flex-col items-center justify-center text-center px-6 pl-14 py-8 border-[3px] border-ink shadow-[4px_4px_0_var(--shadow)] bg-[#fbfdfc] [background-image:linear-gradient(#d3e3ec_1px,transparent_1px),linear-gradient(90deg,#d3e3ec_1px,transparent_1px)] [background-size:24px_24px] before:content-[''] before:absolute before:inset-y-0 before:left-10 before:w-px before:bg-[#d0293a]/70"></div>
      <p class="mt-4 mb-0 font-label text-[0.62rem] text-muted">Red marks the stressed vowel. Russian textbooks usually leave it out.</p>
      <div class="mt-5 flex flex-wrap gap-3 justify-between">
        <button type="button" data-fc-flip class="px-btn">Flip ↻</button>
        <a href="/projects/tetrad" class="px-btn !bg-tomato !text-[#fffaf0] hover:!bg-butter hover:!text-[#2a2140]">See Тетрадь ▶</a>
      </div>`);
    render();
    sceneBody.querySelector('[data-fc-flip]')?.addEventListener('click', () => {
      if (!flipped) { flipped = true; chime([659, 880]); unlock('tetrad'); }
      else { flipped = false; i = (i + 1) % CARDS.length; chime([523]); }
      render();
    });
  }
  document.querySelectorAll<HTMLElement>('[data-egg="tetrad"]').forEach(el => el.addEventListener('click', () => tetradScene(0)));

  // 12. Konami code (unlisted bonus) + typed words
  const KONAMI = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let seq: string[] = [];
  let typed = '';
  document.addEventListener('keydown', e => {
    const t = e.target as HTMLElement;
    if (t && (t.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName))) return;
    seq = [...seq, e.key.length === 1 ? e.key.toLowerCase() : e.key].slice(-KONAMI.length);
    if (seq.join() === KONAMI.join()) {
      const on = document.documentElement.classList.toggle('handheld');
      chime([659, 784, 988, 1319]);
      toast('Cheat code accepted', on ? 'Handheld mode: ON' : 'Handheld mode: OFF', { href: '/arcade', label: 'arcade' });
      seq = [];
    }
    if (e.key.length === 1) {
      typed = (typed + e.key.toLowerCase()).slice(-8);
      if (typed.endsWith('joy')) { typed = ''; joyScene(); }
      if (typed.endsWith('privet') || typed.endsWith('привет')) { typed = ''; tetradScene(1); }
    }
  });

  // Non-button eggs (role="button") respond to Enter / Space too
  document.querySelectorAll<HTMLElement>('[data-egg][role="button"]').forEach(el => {
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el.click(); }
    });
  });

  updateCounters();
  (window as any).__secrets = { found, unlock, total: TOTAL, reset: () => { save([]); updateCounters(); }, toast, chime, confetti, openScene, closeScene, typeIn };
</script>
