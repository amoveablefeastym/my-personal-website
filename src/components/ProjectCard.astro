---
import type { CollectionEntry } from 'astro:content';
import WorkCard from './WorkCard.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  featured?: boolean;
}

const { project, index, featured = false } = Astro.props;
const { title, category, description, image, date } = project.data;
---

<WorkCard
  href={`/projects/${project.id}`}
  {title} {category} {description} {image} {date} {index} {featured}
/>
