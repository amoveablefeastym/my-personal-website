---
import type { CollectionEntry } from 'astro:content';
import Sprite from './Sprite.astro';

interface Props {
  entry: CollectionEntry<'writing'>;
  index: number;
}

const { entry, index } = Astro.props;
const { title, date, synopsis, content_type, pdf_url, type, category, image } = entry.data;
const label = type || category;
const dateStr = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const no = String(index + 1).padStart(2, '0');

const href =
  content_type === 'pdf'       ? (pdf_url ?? undefined) :
  content_type === 'full-text' ? `/writing/${entry.id}` :
  undefined;
const isPdf = content_type === 'pdf';
const Tag = href ? 'a' : 'div';
const colors = ['bg-mint', 'bg-lilac', 'bg-sky', 'bg-butter'];
---

<Tag
  href={href}
  target={isPdf ? '_blank' : undefined}
  rel={isPdf ? 'noopener noreferrer' : undefined}
  data-reveal
  class={`group px-box ${href ? 'px-hover' : ''} grid grid-cols-1 sm:grid-cols-[9rem_1fr]`}
>
  <div class={`${colors[index % colors.length]} border-b-[3px] sm:border-b-0 sm:border-r-[3px] border-ink p-4 flex sm:flex-col items-center sm:justify-center gap-3`}>
    <span class="group-bob"><Sprite name="book" scale={4} /></span>
    <span class="font-label text-[0.75rem] text-[#2a2140]">File {no}</span>
  </div>

  <div class="p-5 md:p-7">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-3">
      {label && <span class="px-chip bg-butter">{label}</span>}
      <span class="label">{dateStr}</span>
    </div>
    <h2 class="!m-0 font-pixel font-semibold text-3xl md:text-4xl leading-tight">{title}</h2>
    {synopsis && <p class="mt-3 mb-0 text-ink-2 text-lg leading-relaxed max-w-2xl">{synopsis}</p>}
    {image && (
      <div class="mt-5 border-[3px] border-ink overflow-hidden max-w-xl">
        <img src={image} alt="" loading="lazy" class="w-full h-48 md:h-60 object-cover object-[center_60%]" />
      </div>
    )}
    {href && (
      <p class="mt-5 mb-0 font-label text-[0.75rem] text-ink group-hover:text-tomato">
        {isPdf ? '▶ Open PDF ↗' : '▶ Load file'}
      </p>
    )}
  </div>
</Tag>
