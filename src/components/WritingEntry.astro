---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { title, date, synopsis, content_type, pdf_url, type, category } = entry.data;
const label = type || category;
const dateStr = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const href =
  content_type === 'pdf'       ? (pdf_url ?? '#') :
  content_type === 'full-text' ? `/writing/${entry.id}` :
  undefined;
---

{href ? (
  <a
    href={href}
    target={content_type === 'pdf' ? '_blank' : undefined}
    rel={content_type === 'pdf' ? 'noopener noreferrer' : undefined}
    class="group block p-6 -mx-6 rounded-sm hover:bg-gray-50 dark:hover:bg-[#111] transition-all duration-300 border-l-2 border-transparent hover:border-red-800 dark:hover:border-red-600 relative overflow-hidden no-underline"
  >
    <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-2">
      <h2 class="text-xl md:text-2xl font-serif font-medium text-black dark:text-white group-hover:text-[#8b0000] dark:group-hover:text-red-400 transition-colors rusty-link w-fit">
        {title}
      </h2>
      <div class="flex items-center gap-3 mt-2 md:mt-0">
        {label && <span class="text-[10px] font-sans font-bold uppercase tracking-widest text-gray-400">{label}</span>}
        <span class="text-xs font-sans font-medium text-gray-400 uppercase tracking-widest">{dateStr}</span>
      </div>
    </div>
    {synopsis && (
      <p class="text-gray-600 dark:text-gray-400 font-serif text-lg leading-relaxed mb-4">{synopsis}</p>
    )}
    <span class="text-xs font-sans font-bold text-gray-400 group-hover:text-black dark:group-hover:text-white uppercase tracking-wider transition-colors">
      {content_type === 'pdf' ? 'Read PDF →' : 'Read →'}
    </span>
  </a>
) : (
  <div class="block p-6 -mx-6 rounded-sm border-l-2 border-transparent relative overflow-hidden">
    <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-2">
      <h2 class="text-xl md:text-2xl font-serif font-medium text-black dark:text-white">
        {title}
      </h2>
      <div class="flex items-center gap-3 mt-2 md:mt-0">
        {label && <span class="text-[10px] font-sans font-bold uppercase tracking-widest text-gray-400">{label}</span>}
        <span class="text-xs font-sans font-medium text-gray-400 uppercase tracking-widest">{dateStr}</span>
      </div>
    </div>
    {synopsis && (
      <p class="text-gray-600 dark:text-gray-400 font-serif text-lg leading-relaxed">{synopsis}</p>
    )}
  </div>
)}
