---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { title, date, synopsis, content_type, pdf_url, type, category } = entry.data;
const label = type || category;
const dateStr = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const href =
  content_type === 'pdf'       ? (pdf_url ?? '#') :
  content_type === 'full-text' ? `/writing/${entry.id}` :
  undefined;
---

{href ? (
  <a
    href={href}
    target={content_type === 'pdf' ? '_blank' : undefined}
    rel={content_type === 'pdf' ? 'noopener noreferrer' : undefined}
    class="group block py-12 no-underline border-t border-gray-100 dark:border-gray-800 first:border-t-0"
  >
    {label && (
      <span class="text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-600 mb-4 block">
        {label}
      </span>
    )}
    <h2 class="font-serif text-3xl md:text-4xl font-medium text-black dark:text-white leading-tight mb-3 group-hover:text-[#8b0000] dark:group-hover:text-red-400 transition-colors duration-300">
      {title}
    </h2>
    <p class="font-serif text-sm italic text-gray-400 dark:text-gray-500 mb-4">{dateStr}</p>
    {synopsis && (
      <p class="font-serif text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
        {synopsis}
      </p>
    )}
  </a>
) : (
  <div class="block py-12 border-t border-gray-100 dark:border-gray-800 first:border-t-0">
    {label && (
      <span class="text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-600 mb-4 block">
        {label}
      </span>
    )}
    <h2 class="font-serif text-3xl md:text-4xl font-medium text-black dark:text-white leading-tight mb-3">
      {title}
    </h2>
    <p class="font-serif text-sm italic text-gray-400 dark:text-gray-500 mb-4">{dateStr}</p>
    {synopsis && (
      <p class="font-serif text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
        {synopsis}
      </p>
    )}
  </div>
)}
