---
import Sprite from './Sprite.astro';
interface Props { id?: string }
const { id = 'theme-toggle' } = Astro.props;
---

<button
  id={id}
  data-theme-toggle
  aria-label="Toggle day and night"
  title="Day / night"
  class="w-10 h-10 grid place-items-center border-[3px] border-ink bg-bg-2 shadow-[3px_3px_0_var(--shadow)] hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 transition-transform"
>
  <span data-icon="sun"><Sprite name="sun" scale={2} /></span>
  <span data-icon="moon" class="hidden"><Sprite name="moon" scale={2} /></span>
</button>

<script>
  function syncIcons(theme: string) {
    document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
      btn.querySelector('[data-icon="sun"]')?.classList.toggle('hidden', theme === 'dark');
      btn.querySelector('[data-icon="moon"]')?.classList.toggle('hidden', theme !== 'dark');
    });
  }

  function apply(theme: string) {
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('theme', theme); } catch {}
    syncIcons(theme);
  }

  syncIcons(document.documentElement.dataset.theme ?? 'light');

  document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      apply(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
    });
  });
</script>
