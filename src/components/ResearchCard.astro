---
import type { CollectionEntry } from 'astro:content';
import WorkCard from './WorkCard.astro';

interface Props {
  entry: CollectionEntry<'research'>;
  index: number;
  featured?: boolean;
}

const { entry, index, featured = false } = Astro.props;
const { title, category, description, image, date } = entry.data;
---

<WorkCard
  href={`/research/${entry.id}`}
  {title} {category} {description} {image} {date} {index} {featured}
/>
