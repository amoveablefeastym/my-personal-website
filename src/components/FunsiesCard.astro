---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'funsies'>;
}

const { post } = Astro.props;
const { title, description, image, tags, category } = post.data;
const colors = ['bg-sky', 'bg-butter', 'bg-mint', 'bg-lilac'];
---

<a href={`/funsies/${post.id}`} data-reveal class="group px-box px-hover flex flex-col">
  <div class="relative aspect-video border-b-[3px] border-ink overflow-hidden bg-bg-2">
    {image
      ? <img src={image} alt="" loading="lazy" class="w-full h-full object-cover" />
      : <div class="w-full h-full grid place-items-center label">no image</div>}
  </div>
  <div class="p-5">
    {category && <p class="label !text-tomato mb-2">{category}</p>}
    <h2 class="!m-0 font-pixel text-3xl">{title}</h2>
    <p class="mt-2 mb-0 text-ink-2">{description}</p>
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-4">
        {tags.map((tag, i) => <span class={`px-chip ${colors[i % colors.length]}`}>{tag}</span>)}
      </div>
    )}
  </div>
</a>
