---
import Layout from '../../layouts/Layout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import ReadEnd from '../../components/ReadEnd.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props:  { project },
  }));
}

const { project } = Astro.props;
const { title, category, image, description, date } = project.data;
const { Content } = await render(project);
---

<Layout title={title} description={description}>
  <div class="max-w-3xl mx-auto px-4 md:px-8">
    <ArticleHeader
      backHref="/projects"
      backLabel="All projects"
      kicker={category}
      {date}
      {title}
      dek={description}
    />
  </div>

  {image && (
    <figure class="max-w-5xl mx-auto px-4 md:px-8 mb-16 anim-pop delay-4">
      <div class="px-box overflow-hidden">
        <img src={image} alt={title} class="w-full aspect-video object-cover" />
      </div>
    </figure>
  )}

  <div class="max-w-3xl mx-auto px-4 md:px-8">
    <article class="prose prose-lg max-w-none">
      <Content />
    </article>
    <ReadEnd id={`projects/${project.id}`} backHref="/projects" backLabel="All projects" />
  </div>
</Layout>
