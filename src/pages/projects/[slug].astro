---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props:  { project },
  }));
}

const { project } = Astro.props;
const { title, category, image, description } = project.data;
const { Content } = await render(project);
---

<Layout title={title} description={description}>
  <div class="max-w-3xl mx-auto px-6 py-12 animate-fade-in-up">

    <a href="/projects" class="inline-flex items-center text-[#707070] dark:text-gray-400 hover:text-black dark:hover:text-white transition-colors mb-8 font-serif italic no-underline">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><polyline points="15 18 9 12 15 6"/></svg>
      Back to Projects
    </a>

    <span class="text-[#d32f2f] font-sans text-xs font-bold tracking-widest mb-4 block uppercase">
      {category}
    </span>

    <h1 class="text-4xl md:text-5xl font-serif font-semibold mb-8 text-black dark:text-white leading-tight">
      {title}
    </h1>

    {image && (
      <img
        src={image}
        alt={title}
        class="w-full aspect-video object-cover mb-10 rounded-sm"
      />
    )}

    <div class="prose prose-lg prose-headings:font-serif prose-p:font-serif prose-p:text-[#333] dark:prose-p:text-gray-300 dark:prose-headings:text-white dark:prose-strong:text-white dark:prose-a:text-white dark:prose-li:text-gray-300 max-w-none">
      <Content />
    </div>

  </div>
</Layout>
