---
import Layout from '../../layouts/Layout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('research'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Research">
  <div class="max-w-6xl mx-auto px-6 md:px-12 bg-white dark:bg-black py-12 relative">

    <div
      class="text-center mb-16 border-b border-black/10 dark:border-white/10 pb-12 relative group cursor-default"
      x-data
    >
      <h1 class="mb-4 font-semibold font-serif tracking-tight text-black dark:text-white text-5xl md:text-6xl animate-fade-in-up relative inline-block">
        Research
      </h1>
      <p class="text-[#707070] dark:text-gray-400 font-serif text-lg italic leading-relaxed opacity-0 group-hover:opacity-100 transition-opacity duration-700 ease-in-out">
        Papers, projects, and ongoing investigations.
      </p>
    </div>

    {entries.length === 0 ? (
      <p class="text-center font-serif text-gray-400 italic py-12">Nothing here yet — check back soon.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16 animate-fade-in-up delay-200">
        {entries.map((entry, index) => (
          <ResearchCard entry={entry} featured={index === 0} />
        ))}
      </div>
    )}

  </div>
</Layout>
