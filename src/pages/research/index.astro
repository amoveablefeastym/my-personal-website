---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('research'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Research" description="Research by Yimin Huang in HCI and cognitive science.">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <PageHeader
      index="02"
      title="Research"
      subtitle="How people think, learn, and see themselves, studied as carefully as I can."
      count={entries.length}
    />

    {entries.length === 0 ? (
      <p class="text-center font-label text-muted py-12">Nothing here yet. Check back soon.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {entries.map((entry, index) => (
          <ResearchCard entry={entry} index={index} featured={index === 0} />
        ))}
      </div>
    )}
  </div>
</Layout>
