---
import Layout from '../layouts/Layout.astro';
import Sprite from '../components/Sprite.astro';
import { SECRETS } from '../lib/secrets';

const colors = ['bg-sky', 'bg-butter', 'bg-mint', 'bg-lilac', 'bg-tomato'];
---

<Layout title="Sticker Book" description="Secrets hidden around Yimin's website.">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <header class="pt-12 md:pt-16 mb-12">
      <div class="px-box p-6 md:p-10 anim-pop">
        <p class="label mb-4">
          <span class="px-1.5 py-0.5 bg-ink text-bg mr-2">Bonus level</span>
          <span data-secret-count>0/{SECRETS.length}</span> found
        </p>
        <h1 class="!m-0 font-pixel font-bold text-[clamp(3rem,10vw,6.5rem)] leading-[0.9] tracking-tight">
          Sticker book<span class="text-tomato anim-blink">_</span>
        </h1>
        <p class="mt-5 mb-0 max-w-2xl text-lg md:text-xl text-ink-2">
          This site is full of little pieces of me: my apps, my stories, my play. Poke around and collect them.
          Your progress stays in this browser only.
        </p>
        <div class="mt-6 h-6 border-[3px] border-ink bg-bg-2 relative overflow-hidden max-w-xl">
          <span data-progress-bar class="absolute inset-y-0 left-0 bg-mint [background-image:repeating-linear-gradient(90deg,transparent_0_14px,rgba(42,33,64,.35)_14px_17px)] transition-[width] duration-500" style="width:0%"></span>
        </div>
      </div>
    </header>

    <ul class="list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {SECRETS.map((s, i) => (
        <li data-sticker={s.id} class="sticker px-box flex flex-col" data-reveal>
          <div class={`sticker-art ${s.sprite === 'star' ? 'bg-lilac' : colors[i % colors.length]} border-b-[3px] border-ink h-32 grid place-items-center relative`}>
            <span class="sticker-sprite"><Sprite name={s.sprite} scale={5} /></span>
            <span class="sticker-lock absolute inset-0 grid place-items-center bg-bg-2 font-pixel text-5xl text-muted">?</span>
            <span class="absolute top-2 left-2 font-label text-[0.62rem] px-1.5 bg-card text-ink border-2 border-ink">#{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="p-4 flex-1">
            <p class="sticker-name m-0 font-pixel text-2xl">
              <span class="sticker-found-only">{s.name}</span>
              <span class="sticker-locked-only text-muted">???</span>
            </p>
            <p class="sticker-found-only mt-2 mb-0 text-ink-2">{s.found}</p>
            <p class="sticker-locked-only mt-2 mb-0 text-ink-2"><span class="font-label text-[0.62rem] text-tomato mr-1">Hint</span> {s.hint}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4">
      <p class="m-0 label">Stuck? Every hint is literal. Some secrets want typing, not clicking.</p>
      <button type="button" data-reset class="px-btn">Reset progress</button>
    </div>
  </div>
</Layout>

<style>
  /* Locked by default (also without JS) */
  .sticker .sticker-found-only { display: none; }
  .sticker .sticker-sprite { visibility: hidden; }
  .sticker.is-found .sticker-found-only { display: block; }
  .sticker.is-found .sticker-name .sticker-found-only { display: inline; }
  .sticker.is-found .sticker-locked-only,
  .sticker.is-found .sticker-lock { display: none; }
  .sticker.is-found .sticker-sprite { visibility: visible; }
  .sticker:not(.is-found) .sticker-art { background: var(--bg-2); }
  .sticker:not(.is-found) { border-style: dashed; box-shadow: none; }
</style>

<script>
  function render() {
    const api = (window as any).__secrets;
    const found: string[] = api?.found() ?? [];
    const total: number = api?.total ?? 1;
    document.querySelectorAll<HTMLElement>('[data-sticker]').forEach(el => {
      el.classList.toggle('is-found', found.includes(el.dataset.sticker ?? ''));
    });
    const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
    if (bar) bar.style.width = `${(found.length / total) * 100}%`;
  }
  render();
  document.addEventListener('secrets:changed', render);
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    if (confirm('Reset all found secrets?')) (window as any).__secrets?.reset();
  });
</script>
