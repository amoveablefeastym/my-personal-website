---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import WritingEntry from '../../components/WritingEntry.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Writing" description="Stories, screenplays, and plays by Yimin Huang.">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <PageHeader
      index="03"
      title="Writing"
      subtitle="Where everything I notice about people ends up. Stories, a screenplay, and a play opening April 2027."
      count={posts.length}
      countLabel="pieces"
    />

    {posts.length === 0 ? (
      <p class="text-center font-label text-muted py-12">Nothing here yet. Check back soon.</p>
    ) : (
      <div class="grid gap-7">
        {posts.map((entry, index) => <WritingEntry entry={entry} index={index} />)}
      </div>
    )}
  </div>
</Layout>
