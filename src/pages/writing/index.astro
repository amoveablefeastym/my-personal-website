---
import Layout from '../../layouts/Layout.astro';
import WritingEntry from '../../components/WritingEntry.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Writing" description="Stories, essays, and observations.">
  <div class="max-w-3xl mx-auto px-6 md:px-12 bg-white dark:bg-black py-12 relative animate-fade-in-up">

    <div class="text-center mb-16 border-b border-black/10 dark:border-white/10 pb-12 relative group cursor-default">
      <h1 class="mb-4 font-semibold font-serif tracking-tight text-black dark:text-white text-5xl md:text-6xl animate-fade-in-up relative inline-block">
        Writing
      </h1>
      <p class="text-[#707070] dark:text-gray-400 font-serif text-lg leading-relaxed opacity-0 group-hover:opacity-100 transition-opacity duration-700 ease-in-out">
        I write therefore I am.
      </p>
    </div>

    <div>
      {posts.length === 0 ? (
        <p class="text-center font-serif text-gray-400 italic py-12">Nothing here yet — check back soon.</p>
      ) : (
        posts.map(entry => <WritingEntry entry={entry} />)
      )}
    </div>

  </div>
</Layout>
