---
import Layout from '../../layouts/Layout.astro';
import WritingEntry from '../../components/WritingEntry.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Writing" description="Stories, essays, and observations.">
  <div class="max-w-2xl mx-auto px-6 animate-fade-in-up">

    <header class="pt-24 pb-20">
      <h1 class="font-serif text-6xl md:text-7xl font-semibold text-black dark:text-white tracking-tight mb-6">
        Writing
      </h1>
      <p class="font-serif text-lg text-gray-400 dark:text-gray-500 italic leading-relaxed">
        Stories, and things I've observed about the world.
      </p>
    </header>

    <div>
      {posts.length === 0 ? (
        <p class="font-serif text-gray-400 dark:text-gray-600 italic py-12 border-t border-gray-100 dark:border-gray-800">
          Nothing here yet — check back soon.
        </p>
      ) : (
        posts.map(entry => <WritingEntry entry={entry} />)
      )}
    </div>

    <div class="pb-24"></div>

  </div>
</Layout>
