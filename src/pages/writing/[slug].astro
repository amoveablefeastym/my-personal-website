---
import Layout from '../../layouts/Layout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import ReadEnd from '../../components/ReadEnd.astro';
import Sprite from '../../components/Sprite.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts
    .filter(p => p.data.content_type === 'full-text')
    .map(post => ({
      params: { slug: post.id },
      props:  { post },
    }));
}

const { post } = Astro.props;
const { title, date, type, category, synopsis } = post.data;
const label = type || category;
const { Content } = await render(post);
---

<Layout title={title} description={synopsis}>
  <div class="max-w-2xl mx-auto px-4 md:px-8">
    <ArticleHeader
      backHref="/writing"
      backLabel="All writing"
      kicker={label}
      {date}
      {title}
      dek={synopsis}
    />

    <div class="flex items-center gap-4 mb-14" aria-hidden="true">
      <span class="h-[3px] flex-1 bg-ink"></span>
      <Sprite name="heart" scale={3} />
      <span class="h-[3px] flex-1 bg-ink"></span>
    </div>

    <article class="prose prose-lg md:prose-xl max-w-none prose-p:leading-[1.8]">
      <Content />
    </article>
    <ReadEnd id={`writing/${post.id}`} backHref="/writing" backLabel="All writing" />

    <p class="mt-20 text-center font-label text-sm text-muted">— The End —</p>
  </div>
</Layout>
