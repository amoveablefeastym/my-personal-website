---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts
    .filter(p => p.data.content_type === 'full-text')
    .map(post => ({
      params: { slug: post.id },
      props:  { post },
    }));
}

const { post } = Astro.props;
const { title, date, type, category, synopsis } = post.data;
const label = type || category;
const { Content } = await render(post);

const dateStr = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<Layout title={title} description={synopsis}>
  <div class="max-w-3xl mx-auto px-6 py-12 animate-fade-in-up">

    <a href="/writing" class="inline-flex items-center text-[#707070] dark:text-gray-400 hover:text-black dark:hover:text-white transition-colors mb-8 font-serif italic no-underline">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><polyline points="15 18 9 12 15 6"/></svg>
      Back to Writing
    </a>

    <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-6">
      {label && <span class="text-[#d32f2f] font-sans text-xs font-bold uppercase tracking-widest">{label}</span>}
      <span class="text-gray-400 font-sans text-xs uppercase tracking-widest">{dateStr}</span>
    </div>

    <h1 class="text-4xl md:text-5xl font-serif font-semibold mb-4 text-black dark:text-white leading-tight">
      {title}
    </h1>

    {synopsis && (
      <p class="font-serif text-lg text-gray-500 dark:text-gray-400 italic mb-12 leading-relaxed">
        {synopsis}
      </p>
    )}

    <article class="prose prose-lg prose-headings:font-serif prose-p:font-serif prose-p:text-[#333] dark:prose-p:text-gray-300 dark:prose-headings:text-white dark:prose-strong:text-white dark:prose-a:text-white dark:prose-li:text-gray-300 max-w-none">
      <Content />
    </article>

  </div>
</Layout>
