          <dd class="m-0 font-pixel text-2xl font-semibold">Product Builder · Researcher · Writer</dd>
        </div>
        <div class="p-4 -mx-1 border-[3px] border-ink bg-butter text-[#2a2140] shadow-[3px_3px_0_var(--shadow)]">
          <dt class="font-label text-[0.68rem] mb-1">★ Main quest: Product</dt>
          <dd class="m-0">
            <span class="block text-lg leading-snug">Figuring out what to build, for whom, and why. Then getting it shipped.</span>
            <span class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-label text-[0.65rem]">
              <a href="/projects/classhub" class="underline decoration-2 underline-offset-2 hover:text-tomato">PM · ClassHub ▶</a>
              <a href="/projects/shopify-for-students" class="underline decoration-2 underline-offset-2 hover:text-tomato">Product strategy · Shopify ▶</a>
              <a href="/projects/ctec-searcher" class="underline decoration-2 underline-offset-2 hover:text-tomato">PM · CTEC Searcher ▶</a>
            </span>
          </dd>
        </div>
        <div>
          <dt class="label mb-1">Guild</dt>
          <dd class="m-0 font-pixel text-2xl font-semibold">Northwestern University</dd>
        </div>
        <div>
          <dt class="label mb-1">Home</dt>
          <dd class="m-0 text-lg">China <span class="text-muted">·</span> Singapore <span class="text-muted">·</span> Evanston, IL</dd>
        </div>
        <div>
          <dt class="label mb-1">Languages</dt>
          <dd class="m-0 flex flex-wrap gap-2">
            <span class="px-chip bg-sky">English</span>
            <span class="px-chip bg-tomato !text-[#fffaf0] !font-sans !text-sm !py-0">中文 Mandarin</span>
            <button type="button" data-egg="tetrad" title="Flip a flashcard" class="px-chip bg-card !font-sans !text-sm !py-0 shadow-[2px_2px_0_var(--shadow)] hover:-translate-y-0.5 transition-transform">Русский <span class="font-label text-[0.6rem] text-muted">(learning)</span></button>
          </dd>
        </div>
        <div>
          <dt class="label mb-1">Majors</dt>
          <dd class="m-0 text-lg">Computer Science, Cognitive Science, Design</dd>
        </div>
        <div>
          <dt class="label mb-2">Quests completed</dt>
          <dd class="m-0 grid gap-2">
            {worlds.slice(0, 3).map(w => (
              <div class="grid grid-cols-[5.5rem_1fr_2rem] items-center gap-3 font-label text-[0.72rem]">
                <span>{w.label}</span>
                <span class="h-4 border-2 border-ink bg-bg-2 relative overflow-hidden">
                  <span class={`absolute inset-y-0 left-0 ${w.color} [background-image:repeating-linear-gradient(90deg,transparent_0_10px,rgba(42,33,64,.35)_10px_12px)]`} style={`width:${(w.count / maxCount) * 100}%`}></span>
                </span>
