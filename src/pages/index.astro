            {item.image && <img src={item.image} alt="" loading="lazy" class="w-full h-full object-cover" />}
            {i === 0 && <span class="absolute top-3 left-3 px-chip bg-butter shadow-[2px_2px_0_var(--shadow)] anim-bob">NEW!</span>}
          </div>
          <div class="p-4">
            <div class="flex justify-between font-label text-[0.68rem] text-muted mb-2">
              <span class="text-tomato">{item.kind}</span>
              <span>{item.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            </div>
            <h3 class="!m-0 font-pixel text-2xl">{item.title.split(': ')[0]}</h3>
            <p class="mt-2 mb-0 text-ink-2 text-[0.95rem] line-clamp-2">{item.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* Without JS every line shows; with JS, one at a time */
  :global(.js) .dialog [data-line]:not(.active) { display: none; }
  :global(.js) .dialog [data-line] { margin-bottom: 0 !important; }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-dialog]');
  if (box) {
    const lines = Array.from(box.querySelectorAll<HTMLElement>('[data-line]'));
    const progress = box.querySelector('[data-progress]');
    const nextLabel = box.querySelector('[data-next-label]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0;
    let timer: number | undefined;
    let typing = false;

    const type = (el: HTMLElement) => {
      const text = el.dataset.text ?? '';
      if (reduce) { el.textContent = text; return; }
      typing = true;
      let n = 0;
      el.textContent = '';
      clearInterval(timer);
      timer = window.setInterval(() => {
        n += 1;
        el.textContent = text.slice(0, n);
        if (n >= text.length) { clearInterval(timer); typing = false; }
      }, 22);
    };

    const show = (i: number) => {
      lines.forEach((l, j) => l.classList.toggle('active', j === i));
      if (progress) progress.textContent = `${i + 1} / ${lines.length}`;
      if (nextLabel) nextLabel.textContent = i === lines.length - 1 ? 'Again' : 'Next';
      type(lines[i]);
    };

    const advance = () => {
      if (typing) {
        clearInterval(timer);
        typing = false;
        lines[idx].textContent = lines[idx].dataset.text ?? '';
        return;
      }
      idx = (idx + 1) % lines.length;
      show(idx);
    };

    box.querySelectorAll<HTMLButtonElement>('[data-lang]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const zh = btn.dataset.lang === 'zh';
        box.querySelectorAll('[data-lang]').forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
        lines.forEach(l => { l.dataset.text = (zh ? l.dataset.textZh : l.dataset.textEn) ?? ''; l.lang = zh ? 'zh-Hans' : 'en'; });
        document.querySelector('[data-hi-en]')?.toggleAttribute('hidden', zh);
        document.querySelector('[data-hi-zh]')?.toggleAttribute('hidden', !zh);
        show(idx);
      });
    });

    box.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a, [data-lang]')) return;
      advance();
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); advance(); }
    });

    show(0);
  }

  // Skill chips: show where each skill shows up
  const panel = document.getElementById('skill-panel');
  const seen = new Set<string>();
  const escHtml = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  document.querySelectorAll<HTMLButtonElement>('[data-skill]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-skill]').forEach(b => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      const skill = btn.dataset.skill ?? '';
      const hits = JSON.parse(btn.dataset.hits || '[]') as { title: string; href: string }[];
      if (panel && btn.dataset.note) {
        panel.innerHTML = `<span class="font-label text-[0.65rem] text-tomato mr-2">${escHtml(skill)} ▶</span> ${escHtml(btn.dataset.note)}`;
      } else if (panel) {
        panel.innerHTML = hits.length
          ? `<span class="font-label text-[0.65rem] text-tomato mr-2">${escHtml(skill)} ▶ used in</span>` +
            hits.map(h => `<a class="bio-link mr-3" href="${h.href}">${escHtml(h.title)}</a>`).join('')
          : `<span class="font-label text-[0.65rem] text-tomato mr-2">${escHtml(skill)} ▶</span> Still leveling this one up. Ask me about it!`;
      }
      seen.add(skill);
      if (seen.size >= 4) document.dispatchEvent(new CustomEvent('egg:skills'));
    });
  });
</script>
