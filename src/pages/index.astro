  <!-- ── Bonus: arcade + quests ──────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 md:px-8 mt-8" data-reveal>
    <div class="px-box grid md:grid-cols-[auto_1fr_auto] items-center gap-5 p-5 md:p-6 bg-[repeating-linear-gradient(135deg,var(--card)_0_14px,var(--bg-2)_14px_28px)]">
