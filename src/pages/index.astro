---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import { getCollection } from 'astro:content';

const featuredProjects = (await getCollection('projects'))
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const interests = [
  "React", "Design Systems", "Cognitive Science", "Web Development",
  "Qualitative Research", "Prototyping", "Machine Learning", "HCI",
  "Neuroscience", "Data Visualization", "AI Literacy", "Health Tech"
];
---

<Layout title="Home">
  <div class="w-full flex flex-col items-center">

    <!-- Hero -->
    <div class="min-h-[80vh] flex flex-col items-center justify-center text-center mt-12 md:mt-20 px-4 max-w-4xl mx-auto relative z-10">

      <!-- Profile picture with Rusty Lake frame + easter egg -->
      <div class="relative mb-8 group cursor-pointer rusty-frame">
        <!-- Black cube easter egg -->
        <div class="absolute -top-16 left-1/2 transform -translate-x-1/2 w-0 h-0 bg-black dark:bg-white opacity-0 group-hover:w-12 group-hover:h-12 group-hover:opacity-100 transition-all duration-1000 ease-in-out rotate-45 shadow-[0_0_30px_rgba(0,0,0,0.8)] dark:shadow-[0_0_30px_rgba(255,255,255,0.8)] z-20 border border-white/20"></div>
        <!-- Hidden text -->
        <div class="absolute -bottom-12 left-1/2 transform -translate-x-1/2 text-xs font-typewriter tracking-widest text-[#8b0000] opacity-0 group-hover:opacity-100 transition-opacity duration-700 delay-300 whitespace-nowrap">
          THE PAST IS NEVER DEAD
        </div>

        <div class="absolute inset-0 rounded-full bg-gray-200 dark:bg-gray-800 transform translate-x-2 translate-y-2 group-hover:translate-x-1 group-hover:translate-y-1 transition-transform duration-300 ease-out -z-10"></div>
        <img
          src="/images/profile.JPG"
          alt="Profile picture of Yimin"
          class="w-[280px] h-[280px] sm:w-[320px] sm:h-[320px] rounded-full object-cover animate-fade-in-up transition-all duration-700 ease-out border-4 border-white dark:border-black shadow-xl corrupted-soul-filter"
        />
      </div>

      <!-- Name with glitch -->
      <h1 class="font-serif font-medium tracking-tight mb-4 text-5xl sm:text-6xl md:text-7xl animate-fade-in-up delay-200 text-black dark:text-white relative z-10">
        Hi, I'm <span class="italic relative inline-block hover:text-[#8b0000] transition-colors duration-300 cursor-default rusty-link rusty-glitch" data-text="Yimin">Yimin</span>.
      </h1>

      <!-- Atmospheric symbols -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none select-none z-0">
        <svg class="rusty-symbol top-[10%] left-[5%] w-24 h-24 animate-float" viewBox="0 0 100 100">
          <path d="M50 15 L85 85 L15 85 Z" fill="none" stroke="currentColor" stroke-width="1" class="text-black dark:text-white" />
        </svg>
        <svg class="rusty-symbol top-[20%] right-[10%] w-16 h-16 animate-float" style="animation-delay: 1s" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="40" fill="none" stroke="currentColor" stroke-width="1" class="text-black dark:text-white" />
        </svg>
        <svg class="rusty-symbol bottom-[30%] left-[15%] w-20 h-20 animate-float" style="animation-delay: 2s" viewBox="0 0 100 100">
          <rect x="15" y="15" width="70" height="70" fill="none" stroke="currentColor" stroke-width="1" class="text-black dark:text-white" />
        </svg>
      </div>

      <!-- Bio -->
      <section class="max-w-[640px] mb-10 text-left animate-fade-in-up delay-300">
        <p class="font-serif text-base sm:text-lg uppercase tracking-[0.14em] text-gray-500 dark:text-[#8f8f8f]">
          At a glance
        </p>
        <ul class="mt-4 space-y-4">
          <li class="rounded-xl border border-black/10 dark:border-white/15 bg-white/80 dark:bg-black/30 px-5 py-4 font-serif text-gray-700 dark:text-[#d0d0d0] text-lg sm:text-xl leading-relaxed shadow-sm">
            I am an undergraduate at <strong class="font-medium text-black dark:text-white">Northwestern University</strong>, where I study
            <strong class="font-medium text-black dark:text-white">Computer Science</strong>,
            <strong class="font-medium text-black dark:text-white">Cognitive Science</strong>, and
            <strong class="font-medium text-black dark:text-white">Design</strong>.
          </li>
          <li class="rounded-xl border border-black/10 dark:border-white/15 bg-white/80 dark:bg-black/30 px-5 py-4 font-serif text-gray-700 dark:text-[#d0d0d0] text-lg sm:text-xl leading-relaxed shadow-sm">
            My <a href="/research" class="bio-link">research</a> lives in <strong class="font-medium text-black dark:text-white">Human-Computer Interaction</strong>, and <a href="/projects" class="bio-link">my work</a> is grounded in
            <strong class="font-medium text-black dark:text-white">product thinking</strong>: building with care, clarity, and purpose.
          </li>
          <li class="rounded-xl border border-black/10 dark:border-white/15 bg-white/80 dark:bg-black/30 px-5 py-4 font-serif text-gray-700 dark:text-[#d0d0d0] text-lg sm:text-xl leading-relaxed shadow-sm">
            I am also a <a href="/writing" class="bio-link">writer</a>. I wrote a screenplay and am now writing a stage play! I also write short stories, things that happen in my life and things that I observe about the world.
           
          </li>
        </ul>
      </section>

      <!-- Social links -->
      <div class="flex flex-row gap-8 justify-center animate-fade-in-up delay-500 mb-20">
        <a href="https://github.com/amoveablefeastym" target="_blank" rel="noreferrer" aria-label="GitHub"
           class="text-gray-600 dark:text-[#e8e8e8] hover:text-black dark:hover:text-white hover:scale-110 transition-all duration-300">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/yimin-huang-nu" target="_blank" rel="noreferrer" aria-label="LinkedIn"
           class="text-gray-600 dark:text-[#e8e8e8] hover:text-black dark:hover:text-white hover:scale-110 transition-all duration-300">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <a href="mailto:h1683618346@gmail.com" aria-label="Email"
           class="text-gray-600 dark:text-[#e8e8e8] hover:text-black dark:hover:text-white hover:scale-110 transition-all duration-300">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Marquee -->
    <div class="w-full animate-fade-in-up delay-700">
      <Marquee items={interests} />
    </div>

  </div>
</Layout>
