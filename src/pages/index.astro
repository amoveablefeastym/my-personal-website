  <!-- ── Recently unlocked ───────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 md:px-8 mt-24 md:mt-32">
    <div class="flex items-end justify-between mb-6" data-reveal>
      <h2 class="!m-0 font-label text-sm text-muted">// Recently unlocked</h2>
      <a href="/projects" class="font-label text-[0.72rem] text-ink-2 hover:text-tomato">View all ▶</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {recent.map((item, i) => (
        <a href={item.href} data-reveal style={`transition-delay:${i * 90}ms`} class="group px-box px-hover flex flex-col">
