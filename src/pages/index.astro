      <h2 class="!m-0 font-label text-sm text-muted">// Choose a world</h2>
      <span class="hidden md:inline label">press 1–4</span>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
      {worlds.map((w, i) => (
        <a href={w.href} data-reveal style={`transition-delay:${i * 70}ms`} class="group px-box px-hover flex flex-col">
          <div class={`${w.color} border-b-[3px] border-ink grid place-items-center h-36 md:h-44 relative`}>
