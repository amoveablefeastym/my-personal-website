---
import Layout from '../layouts/Layout.astro';
import Sprite from '../components/Sprite.astro';
import Globe from '../components/Globe.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const research = await getCollection('research');
const writing  = await getCollection('writing');
const funsies  = await getCollection('funsies');

const recent = [
  ...projects.map(p => ({ ...p.data, href: `/projects/${p.id}`, kind: 'Project' })),
  ...research.map(r => ({ ...r.data, href: `/research/${r.id}`, kind: 'Research' })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);

const worlds = [
  { key: '1', label: 'Projects', href: '/projects', sprite: 'computer', color: 'bg-sky',    count: projects.length, note: 'Products I scoped, led, designed, and built.' },
  { key: '2', label: 'Research', href: '/research', sprite: 'globe',    color: 'bg-lilac',  count: research.length, note: 'HCI, culture, cognition, and AI literacy.' },
  { key: '3', label: 'Writing',  href: '/writing',  sprite: 'book',     color: 'bg-mint',   count: writing.length,  note: 'Stories, a screenplay, a stage play.' },
  { key: '4', label: 'Funsies',  href: '/funsies',  sprite: 'bread',    color: 'bg-butter', count: funsies.length,  note: 'Me having a life.' },
];

const skills = [
  'Product Management', 'Product Strategy', 'User Research',
  'React', 'Design Systems', 'Cognitive Science', 'Web Development',
  'Qualitative Research', 'Prototyping', 'Machine Learning', 'HCI',
  'Neuroscience', 'Data Visualization', 'AI Literacy', 'Health Tech',
  'Cross-Cultural Research', 'Mandarin', 'Russian',
];
const chipColors = ['bg-sky', 'bg-butter', 'bg-mint', 'bg-lilac', 'bg-tomato'];

// Where does each skill actually show up? Search the case studies so the chips stay honest.
const skillPatterns: Record<string, RegExp> = {
  'Product Management': /project manag|product manag|product scope|feature set|roadmap|led a team/i,
  'Product Strategy': /product strateg|go-to-market|revenue|business|market/i,
  'User Research': /user research|interview|usability|survey|participants/i,
  'React': /\breact\b/i,
  'Design Systems': /design system/i,
  'Cognitive Science': /cogniti|cognitive science|working memory/i,
  'Web Development': /web app|website|full-?stack|frontend|front-end|next\.js|firebase/i,
  'Qualitative Research': /interview|qualitative|user research|survey|usability/i,
  'Prototyping': /prototyp|figma/i,
  'Machine Learning': /machine learning|\bML\b|classifier|decod|neural network|LLM/i,
  'HCI': /\bHCI\b|human-computer/i,
  'Neuroscience': /neuro/i,
  'Data Visualization': /visuali[sz]/i,
  'AI Literacy': /AI literacy/i,
  'Health Tech': /health|medical|clinical|biometric/i,
  'Cross-Cultural Research': /cultur/i,
  'Mandarin': /mandarin|chinese|中文/i,
  'Russian': /russian|тетрадь/i,
};
const allWork = [
  ...projects.map(p => ({ title: p.data.title.split(': ')[0], href: `/projects/${p.id}`, text: `${p.data.title} ${p.data.description} ${p.data.category} ${p.body ?? ''}` })),
  ...research.map(r => ({ title: r.data.title.split(': ')[0], href: `/research/${r.id}`, text: `${r.data.title} ${r.data.description} ${r.data.category} ${r.body ?? ''}` })),
];
const skillHits = Object.fromEntries(
  skills.map(s => [s, allWork.filter(w => skillPatterns[s]?.test(w.text)).map(({ title, href }) => ({ title, href }))])
);

const linesZh = [
  `我在西北大学读本科，主修计算机科学、认知科学和设计。`,
  `职业上，我最热爱的是做产品：想清楚要做什么、带领团队把它做出来，并真正关心使用它的人。我的研究方向是人机交互。`,
  `我也是一名写作者！我写过一部电影剧本，现在正在写一部舞台剧。我也写短篇小说，写生活里发生的事，也写我对这个世界的观察。`,
];

const lines = [
  `I'm an undergrad at Northwestern University, studying Computer Science, Cognitive Science, and Design.`,
  `Professionally, I'm most excited about product: scoping what to build, leading teams to build it, and caring about the people who use it. My research lives in Human-Computer Interaction.`,
  `I'm also a writer! I wrote a screenplay and am now writing a stage play. I write short stories too, about things that happen in my life and things I notice about the world.`,
];

const pad = (n: number) => String(n).padStart(2, '0');
const maxCount = Math.max(...worlds.map(w => w.count), 1);
---

<Layout title="Home">
  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 md:px-8 pt-12 md:pt-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-start">

      <!-- Portrait -->
      <div class="md:col-span-5 relative anim-pop">
        <button type="button" data-egg="bubble" title="A floating bubble…" aria-label="A floating bubble. Click to pop it." class="absolute -top-7 -right-2 md:-right-6 z-10 anim-drift">
          <Sprite name="bubble" scale={4} />
        </button>
        <span class="absolute -top-4 -left-3 z-10 anim-bob"><Sprite name="star" scale={4} /></span>
        <button type="button" data-egg="globe" title="A tiny spinning world…" aria-label="A spinning globe. Click to spin it." class="absolute -bottom-12 left-2 md:-left-2 z-10 hover:scale-110 transition-transform">
          <Globe scale={5} />
        </button>

        <figure data-egg="poke" role="button" tabindex="0" aria-label="Portrait of Yimin. Click to poke." class="group relative px-box p-3 m-0 max-w-[360px] mx-auto md:mx-0 rotate-[-1.5deg] hover:rotate-0 transition-transform duration-200 select-none">
          <span data-poke-bubble class="hidden absolute z-20 -top-12 left-1/2 -translate-x-1/2 whitespace-nowrap px-3 py-1.5 bg-card border-[3px] border-ink shadow-[3px_3px_0_var(--shadow)] font-pixel text-base after:content-[''] after:absolute after:left-1/2 after:-bottom-[9px] after:w-3 after:h-3 after:bg-card after:border-r-[3px] after:border-b-[3px] after:border-ink after:rotate-45 after:-translate-x-1/2"></span>
          <div class="relative aspect-square border-[3px] border-ink overflow-hidden bg-bg-2">
            <img src="/images/pixel/me-48.png" alt="Pixel-art portrait of Yimin" class="pixelated absolute inset-0 w-full h-full transition-opacity duration-300 group-hover:opacity-0" />
            <img src="/images/pixel/me-real.jpg" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
          </div>
          <figcaption class="mt-3 flex items-center justify-between font-label text-[0.72rem]">
            <span class="px-2 py-0.5 bg-ink text-bg">P1 · YIMIN</span>
            <span class="text-muted group-hover:hidden">hover · or poke</span>
            <span class="text-tomato hidden group-hover:inline">hi, it's me ♥</span>
          </figcaption>
        </figure>
      </div>

      <!-- Intro -->
      <div class="md:col-span-7">
        <p class="label mb-4 anim-pop delay-1">
          <span class="inline-block w-2.5 h-2.5 bg-mint border-2 border-ink align-middle mr-2 anim-blink"></span>
          Now playing · Product · Research · Writing
        </p>
        <h1 class="!m-0 font-pixel font-bold text-[clamp(3.2rem,9vw,6.5rem)] leading-[0.95] tracking-tight anim-pop delay-2">
          <span data-hi-en>Hi, I'm</span><span data-hi-zh hidden class="font-sans font-bold">你好，我是</span> <span class="relative inline-block text-tomato">Yimin<span class="absolute left-0 right-0 -bottom-1 h-2 bg-butter -z-10"></span></span>!
        </h1>
        <p class="mt-5 mb-0 text-xl md:text-2xl text-ink-2 max-w-xl anim-pop delay-3">
          I build <span class="text-ink font-semibold">products</span>: figuring out what to make, for whom, and why, then shipping it. I also study how people think with computers, and write stories.
        </p>

        <!-- RPG dialogue box -->
        <div class="dialog relative mt-10 px-box p-5 pt-7 md:p-6 md:pt-8 anim-pop delay-4" data-dialog role="region" aria-label="About Yimin" tabindex="0">
          <span class="absolute -top-4 left-4 px-3 py-0.5 bg-tomato text-[#fffaf0] border-[3px] border-ink font-label text-[0.75rem]">YIMIN</span>
          <div class="min-h-[7.5rem] md:min-h-[6rem] text-lg md:text-[1.2rem] leading-relaxed text-ink">
            {lines.map((line, i) => (
              <p data-line data-text={line} data-text-en={line} data-text-zh={linesZh[i]} class={`m-0 mb-3 last:mb-0 ${i === 0 ? 'active' : ''}`}>{line}</p>
            ))}
          </div>
          <div class="mt-4 flex items-center justify-between font-label text-[0.7rem] text-muted">
            <span class="flex items-center gap-3">
              <span data-progress>1 / {lines.length}</span>
