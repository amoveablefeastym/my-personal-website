      </dl>
      <div class="p-6 md:p-8">
        <p class="label mb-3">Skills &amp; interests</p>
        <ul class="list-none p-0 m-0 flex flex-wrap gap-2.5">
          {skills.map((s, i) => (
            <li>
              <button
                type="button"
                data-skill={s}
                data-hits={JSON.stringify(skillHits[s])}
                data-note={s === 'Mandarin' ? 'Fluent. 我会说中文！Spin the globe for more.' : undefined}
                aria-controls="skill-panel"
                class={`px-chip ${chipColors[i % chipColors.length]} shadow-[2px_2px_0_var(--shadow)] hover:-translate-y-0.5 active:translate-y-0.5 transition-transform aria-pressed:outline-[3px] aria-pressed:outline-dashed aria-pressed:outline-offset-2 aria-pressed:outline-ink`}
