---
import Layout from '../../layouts/Layout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import ReadEnd from '../../components/ReadEnd.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('funsies');
  return posts.map(post => ({
    params: { slug: post.id },
    props:  { post },
  }));
}

const { post } = Astro.props;
const { title, description, date, tags, image, category } = post.data;
const { Content } = await render(post);
---

<Layout title={title} description={description}>
  <div class="max-w-3xl mx-auto px-4 md:px-8">
    <ArticleHeader
      backHref="/funsies"
      backLabel="All funsies"
      kicker={category}
      {date}
      {title}
      dek={description}
    />

    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-10">
        {tags.map(tag => (
          <span class="px-chip bg-butter">{tag}</span>
        ))}
      </div>
    )}

    {image && (
      <div class="px-box overflow-hidden mb-14">
        <img src={image} alt={title} class="w-full aspect-video object-cover" />
      </div>
    )}

    <article class="prose prose-lg max-w-none">
      <Content />
    </article>
    <ReadEnd id={`funsies/${post.id}`} backHref="/funsies" backLabel="All funsies" />
  </div>
</Layout>
