---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FunsiesCard from '../../components/FunsiesCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('funsies'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Funsies" description="Me having a life.">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <PageHeader
      index="04"
      title="Funsies"
      subtitle="Me having a life."
      count={posts.length}
    />

    {posts.length === 0 ? (
      <div class="py-16 md:py-24 text-center" data-reveal>
        <p class="font-pixel text-3xl md:text-4xl text-ink mb-3">This level is still loading…</p>
        <p class="label">New save data coming soon. Come back later.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {posts.map(post => <FunsiesCard post={post} />)}
      </div>
    )}
  </div>
</Layout>
